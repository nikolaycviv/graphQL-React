# Local MongoDB (docker compose). For Atlas, replace with your
# mongodb+srv://<user>:<pass>@<cluster>/events-graphql URI.
MONGODB_URI=mongodb://root:example@127.0.0.1:27017/events-graphql?authSource=admin
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=example
PORT=4000
JWT_SECRET=dev-only-change-me
